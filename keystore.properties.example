# 复制本文件为 keystore.properties 并填写你的签名信息（keystore.properties 已被 .gitignore 忽略，不会上传）
# 生成 keystore 命令（在终端执行）：
#   keytool -genkey -v -keystore weather-release.keystore -alias weather -keyalg RSA -keysize 2048 -validity 10000
#
# 然后填写下面四项：
STORE_FILE=../weather-release.keystore
STORE_PASSWORD=你的密钥库密码
KEY_ALIAS=weather
KEY_PASSWORD=你的密钥密码
