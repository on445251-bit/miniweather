<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 天气背景动画（最底层） -->
    <com.example.weather.WeatherBackground
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sunny" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 可读性遮罩：晴天背景很亮时保证文字与卡片对比度 -->
        <View
            android:id="@+id/scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ===== 固定顶栏（Material 3 风格） ===== -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_menu"
                app:title="@string/app_name"
                app:titleTextColor="#FFFFFF" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_card"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:alpha="0.6"
                        android:contentDescription="@string/search_hint"
                        app:srcCompat="@drawable/ic_search"
                        app:tint="?attr/colorOnSurface" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_city"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_loc"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/current_location"
                        app:srcCompat="@drawable/ic_loc"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 注意：SwipeRefreshLayout 的直接子 View 必须是可滚动容器，
                     否则 canChildScrollUp() 恒为 false，任何方向的手势都会被当成下拉刷新 -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:paddingBottom="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <!-- ===== 当前天气（Hero） ===== -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_hero"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                app:cardBackgroundColor="@color/hero_bg"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:layout_width="150dp"
                                        android:layout_height="150dp"
                                        android:layout_gravity="end|top"
                                        android:alpha="0.16"
                                        android:contentDescription="@null"
                                        android:paddingTop="6dp"
                                        android:paddingEnd="6dp"
                                        app:srcCompat="@drawable/ic_sun" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="18dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:id="@+id/tv_city"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:letterSpacing="0.02"
                                                android:textColor="#FFFFFF"
                                                android:textSize="20sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_source"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:alpha="0.85"
                                                android:background="@drawable/bg_pill"
                                                android:paddingStart="8dp"
                                                android:paddingTop="2dp"
                                                android:paddingEnd="8dp"
                                                android:paddingBottom="2dp"
                                                android:textColor="#FFFFFF"
                                                android:textSize="10sp" />
                                        </LinearLayout>

                                        <TextView
                                            android:id="@+id/tv_area"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:alpha="0.88"
                                            android:textColor="#FFFFFF"
                                            android:textSize="12sp" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="10dp"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:id="@+id/tv_temp"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textColor="#FFFFFF"
                                                android:textSize="64sp"
                                                android:textStyle="bold" />

                                            <ImageView
                                                android:id="@+id/iv_icon"
                                                android:layout_width="72dp"
                                                android:layout_height="72dp"
                                                android:layout_marginStart="8dp"
                                                android:contentDescription="@null"
                                                app:srcCompat="@drawable/ic_sun" />
                                        </LinearLayout>

                                        <TextView
                                            android:id="@+id/tv_desc"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="-6dp"
                                            android:alpha="0.95"
                                            android:textColor="#FFFFFF"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:id="@+id/tv_extra"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:alpha="0.85"
                                            android:textColor="#FFFFFF"
                                            android:textSize="12sp" />

                                        <!-- 指标网格 -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:alpha="0.7"
                                                    android:text="@string/m_feels"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="11sp" />

                                                <TextView
                                                    android:id="@+id/tv_body"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="15sp"
                                                    android:textStyle="bold" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:alpha="0.7"
                                                    android:text="@string/m_humidity"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="11sp" />

                                                <TextView
                                                    android:id="@+id/tv_humidity"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="15sp"
                                                    android:textStyle="bold" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:alpha="0.7"
                                                    android:text="@string/m_wind"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="11sp" />

                                                <TextView
                                                    android:id="@+id/tv_wind"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="15sp"
                                                    android:textStyle="bold" />
                                            </LinearLayout>
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="10dp"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:alpha="0.7"
                                                    android:text="@string/m_pressure"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="11sp" />

                                                <TextView
                                                    android:id="@+id/tv_pressure"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="15sp"
                                                    android:textStyle="bold" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:alpha="0.7"
                                                    android:text="@string/m_cloud"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="11sp" />

                                                <TextView
                                                    android:id="@+id/tv_cloud"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="15sp"
                                                    android:textStyle="bold" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:alpha="0.7"
                                                    android:text="@string/m_precip"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="11sp" />

                                                <TextView
                                                    android:id="@+id/tv_precip"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textColor="#FFFFFF"
                                                    android:textSize="15sp"
                                                    android:textStyle="bold" />
                                            </LinearLayout>
                                        </LinearLayout>
                                    </LinearLayout>
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 预警 ===== -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_alert"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="14dp">

                                    <TextView
                                        android:id="@+id/tv_alert_badge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_pill"
                                        android:paddingStart="9dp"
                                        android:paddingTop="3dp"
                                        android:paddingEnd="9dp"
                                        android:paddingBottom="3dp"
                                        android:textColor="#FFFFFF"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_alert_title"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_alert_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="3dp"
                                            android:lineSpacingExtra="2dp"
                                            android:textSize="12sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 空气质量 ===== -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_air"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:visibility="gone"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tv_aqi"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="34sp"
                                            android:textStyle="bold" />

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="14dp"
                                            android:layout_weight="1"
                                            android:orientation="vertical">

                                            <TextView
                                                android:id="@+id/tv_aqi_level"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="15sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:alpha="0.6"
                                                android:text="@string/air_title"
                                                android:textSize="11sp" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tv_aqi_advice"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:lineSpacingExtra="2dp"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/tv_pollutants"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:alpha="0.75"
                                        android:lineSpacingExtra="3dp"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 逐小时 ===== -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="6dp"
                                android:letterSpacing="0.01"
                                android:paddingStart="6dp"
                                android:text="@string/hourly"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_hourly"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_hourly"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:clipToPadding="false"
                                    android:paddingStart="8dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="10dp"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 温度曲线 ===== -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="6dp"
                                android:letterSpacing="0.01"
                                android:paddingStart="6dp"
                                android:text="@string/trend"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_curve"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <com.example.weather.TempCurveView
                                    android:id="@+id/temp_curve"
                                    android:layout_width="match_parent"
                                    android:layout_height="180dp"
                                    android:paddingTop="6dp" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 7 天 ===== -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="6dp"
                                android:letterSpacing="0.01"
                                android:paddingStart="6dp"
                                android:text="@string/daily"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_daily"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_daily"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="false"
                                    android:paddingTop="6dp"
                                    android:paddingBottom="6dp"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 日出日落 ===== -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_sun"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="16dp">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.6"
                                            android:text="@string/sunrise"
                                            android:textSize="11sp" />

                                        <TextView
                                            android:id="@+id/tv_sunrise"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="17sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.6"
                                            android:text="@string/sunset"
                                            android:textSize="11sp" />

                                        <TextView
                                            android:id="@+id/tv_sunset"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="17sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.6"
                                            android:text="@string/daylight"
                                            android:textSize="11sp" />

                                        <TextView
                                            android:id="@+id/tv_daylight"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="17sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ===== 生活指数 ===== -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="6dp"
                                android:letterSpacing="0.01"
                                android:paddingStart="6dp"
                                android:text="@string/life_index"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_life"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/m3_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_index"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="false"
                                    android:padding="8dp" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tv_updated"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:alpha="0.7"
                                android:gravity="center"
                                android:paddingTop="18dp"
                                android:paddingBottom="8dp"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 侧边栏：城市列表 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
